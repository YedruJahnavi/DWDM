13. Write a R program to cluster your choice of data using simple k-means algorithm using  JDK 
 
# Load dataset 
data(iris) 
print("First few records of Iris dataset:") 
head(iris) 
 
# Use only numeric columns for clustering 
iris_data <- iris[, 1:4] 
 
# Scale the data 
iris_scaled <- scale(iris_data) 
 
# Apply K-Means algorithm 
set.seed(123)  # for reproducibility 
kmeans_result <- kmeans(iris_scaled, centers = 3, nstart = 20) 
 
# Print the clustering results 
print("Cluster centers:") 
print(kmeans_result$centers) 
 
print("Cluster assignments for first 10 rows:") 
print(kmeans_result$cluster[1:10]) 
 
# Add cluster results to the original data 
iris$Cluster <- as.factor(kmeans_result$cluster) 
 
# Compare with actual species 
table(iris$Cluster, iris$Species) 
 
# Visualize the clusters 
library(ggplot2) 
ggplot(iris, aes(x = Sepal.Length, y = Sepal.Width, color = Cluster)) + 
  geom_point(size = 3) + 
  labs(title = "K-Means Clustering on Iris Dataset", 
       x = "Sepal Length", 
       y = "Sepal Width") + 
  theme_minimal() 
 
 
 

import numpy as np 
 
# Step 1: Create your dataset (4 instances, 2 attributes) 
# Example: [Height (cm), Weight (kg)] 
data = np.array([ 
    [160, 55], 
    [170, 65], 
    [165, 60], 
    [180, 75] 
]) 
 
# Step 2: Define a function to compute Euclidean distance 
def euclidean_distance(a, b): 
    return np.sqrt(np.sum((a - b) ** 2)) 
 
# Step 3: Compute the dissimilarity (distance) matrix 
num_instances = data.shape[0] 
dissimilarity_matrix = np.zeros((num_instances, num_instances)) 
 
for i in range(num_instances): 
    for j in range(num_instances): 
        dissimilarity_matrix[i][j] = euclidean_distance(data[i], data[j]) 
 
# Step 4: Display the dissimilarity matrix 
print("Dissimilarity Matrix (Euclidean Distance):") 
print(dissimilarity_matrix) 
 
